{
  "expo": {
    "name": "Barq-e-Insaf",
    "slug": "barq-e-insaf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/barq-e-insaf.png",
    "scheme": "barqeinsaf",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0c0c",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pk.barqeinsaf.admin"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c0c0c",
        "foregroundImage": "./assets/images/barq-e-insaf.png"
      },
      "package": "pk.barqeinsaf.admin"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/barq-e-insaf.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/barq-e-insaf.png",
          "resizeMode": "contain",
          "backgroundColor": "#0c0c0c"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
